<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background"
    android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="WeupNotes" android:textColor="#40536B" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical"
        android:text="Accesos a tus notas online" android:textSize="15sp" android:textColor="#252535" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Requiere conexión a Internet" android:textSize="12sp" android:textColor="#6B6873"
        android:layout_marginBottom="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_new" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="+ Nota"
            android:contentDescription="Crear nota en WeupNotes online" android:textStyle="bold" android:textColor="#FFFFFF"
            android:background="@drawable/widget_action" />
        <TextView android:id="@+id/widget_search" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="Buscar"
            android:contentDescription="Buscar notas online" android:textColor="#40536B" android:textStyle="bold" />
        <TextView android:id="@+id/widget_open" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="Abrir"
            android:contentDescription="Abrir WeupNotes" android:textColor="#40536B" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
