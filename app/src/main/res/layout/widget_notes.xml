<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background"
    android:padding="14dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="WeupNotes" android:textColor="#E92176" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_count" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"
        android:text="Mis notas locales" android:textSize="15sp" android:textColor="#252535" />
    <TextView android:id="@+id/widget_preview" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
        android:text="Vista previa oculta por privacidad" android:textSize="12sp" android:textColor="#6B6873"
        android:layout_marginBottom="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_new" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="+ Nota"
            android:contentDescription="Crear nota local" android:textStyle="bold" android:textColor="#FFFFFF"
            android:background="@drawable/widget_action" />
        <TextView android:id="@+id/widget_search" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="Buscar"
            android:contentDescription="Buscar notas locales" android:textColor="#E92176" android:textStyle="bold" />
        <TextView android:id="@+id/widget_open" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center" android:text="Ver todas"
            android:contentDescription="Ver todas las notas locales" android:textColor="#E92176" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
